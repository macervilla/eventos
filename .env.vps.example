# Generar dos valores diferentes con: openssl rand -hex 32
# Usar hexadecimal para que la clave de PostgreSQL sea segura dentro de DATABASE_URL.
POSTGRES_PASSWORD=
SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLOCK_SKEW_SECONDS=5
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Eventos

# Verificacion de invitados por SMS: opcional, exclusivamente Twilio Verify oficial.
# Sin estas credenciales el metodo telefono rechaza la validacion (no simula envios).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
